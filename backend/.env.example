# Copy to .env. Indexing/retrieval and database tools do not require credentials.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RAG_KNOWLEDGE_BASE_PATH=knowledge_base
RAG_CHROMA_PATH=.cache/chroma
RAG_EMBEDDING_CACHE_PATH=.cache/embeddings
RAG_COLLECTION_PREFIX=storepilot-policies
RAG_TOP_K=4
# Maximum cosine distance; smaller values require closer matches (not confidence).
RAG_MAX_DISTANCE=0.65
DATABASE_PATH=database/retail.db
APPLICATION_DATABASE_PATH=database/storepilot.db
# Set a random signing secret of at least 32 bytes before using persistent login sessions.
JWT_SECRET=
APP_ENV=development
DATA_ROW_LIMIT=50
EVENT_ANCHOR=2026-10-10T12:00:00+05:30
MODEL_TIMEOUT_SECONDS=30
