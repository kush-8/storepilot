# Copy to .env. Local policy Copilot runs without OpenAI credentials.
OPENAI_API_KEY=
# Set a model available to your account that supports structured outputs.
OPENAI_MODEL=
DATABASE_PATH=database/retail.db
APPLICATION_DATABASE_PATH=database/storepilot.db
# Random secret of at least 32 bytes. Required with APP_ENV=production.
# If blank in development, tokens become invalid whenever the process restarts.
JWT_SECRET=
APP_ENV=development
EVENT_ANCHOR=2026-10-10T12:00:00+05:30
MODEL_TIMEOUT_SECONDS=30
